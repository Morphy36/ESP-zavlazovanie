# =============================================================================
#  Skopíruj na secrets.yaml a vyplň. secrets.yaml NIKDY necommituj!
# =============================================================================

# --- WiFi ---
wifi_ssid: "MojaSiet"
wifi_password: "moje-wifi-heslo"

# --- Sieť (statická IP skracuje pripájanie o DHCP) ---
meteo_static_ip: "192.168.0.249"
network_gateway: "192.168.0.1"
network_subnet: "255.255.255.0"
network_dns: "192.168.0.1"

# --- Núdzový AP, ktorý sa otvorí, ak sa WiFi nepripojí ---
ap_password: "zmen-ma-prosim"

# --- Šifrovací kľúč pre Home Assistant API ---
# Vygeneruj:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "base64==32bajtov=================================="

# --- Heslo pre OTA aktualizácie ---
ota_password: "zmen-ma-tiez"
